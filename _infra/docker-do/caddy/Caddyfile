# Caddyfile — docker1 (146.190.130.5)
#
# Caddy serves static sites directly + reverse proxies for Docker services.
# Let's Encrypt auto-provisions TLS for all *.busboom.org domains.
#
# To apply changes:
#   caddy reload --config /etc/caddy/Caddyfile
#   Or: systemctl reload caddy

# ── Global options ──────────────────────────────────────────────
{
    email eric@civicknowledge.com
    admin 0.0.0.0:2019
}

# ── Garage renovation site (static, served directly) ────────────
garage.busboom.org {
    root * /opt/docker-do/sites/garage/public
    file_server

    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
    }
}

# ── Health check endpoint ────────────────────────────────────────
docker1.busboom.org {
    respond "docker1 OK" 200
}