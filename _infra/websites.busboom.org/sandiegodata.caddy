# Redirects for www.sandiegodata.org, imported by its site blocks in Caddyfile.
#
# (sandiegodata_redirects): short links from the WordPress Redirection plugin
# (blog 7, _export/blog7_redirects.csv), with targets updated to the paths of
# the Hugo site. Hugo serves the old WordPress page and post URLs as they were.
#
# (data_sandiegodata): data.sandiegodata.org, the old data repository, now
# part of www.sandiegodata.org. Paths that moved get their new home; every
# other path (/dataset/..., /collections/..., /legal/, /uploads/...) is the
# same on www.

(sandiegodata_redirects) {
	route {
		redir /data /dataset/ permanent
		redir /forum / permanent
		redir /wiki https://sandiegodata.atlassian.net/wiki/display/SDD/San+Diego+Data+Home permanent
		redir /docs/permit-data-feed.pdf https://clarinova.box.com/shared/static/onszjduj3pys41gvlwv8.pdf permanent
		redir /docs/economic-development-repository.pdf https://clarinova.box.com/shared/static/7tk3l98q2vlfarv3dzf8.pdf permanent
		redir /go https://docs.google.com/a/clarinova.com/document/d/1uldk7QKALZgSoWhAsiFe_SQY7p0lCZv-MvDOZQND95Y/edit#heading=h.dyqxh24604z permanent
		redir /hdi /about/reports/a-vision-for-a-shared-data-infrastructure/building-a-california-health-data-infrastructure/ permanent
		redir /industrial-data /about/reports/a-vision-for-a-shared-data-infrastructure/ permanent
		redir /reports/a-vision-for-shared-data-infrastructure* /about/reports/a-vision-for-a-shared-data-infrastructure/a-vision-for-shared-data-infrastructure/ permanent
		redir /reports/a-vision-for-a-shared-data-infrastructure/a-vision-for-shared-data-infrastructure/a-vision-for-a-shared-data-infrastructure-part-2* /about/reports/a-vision-for-a-shared-data-infrastructure/industrial-data-production/ permanent
		redir /reports/a-vision-for-a-shared-data-infrastructure/a-vision-for-a-shared-data-infrastructure-part-2* /about/reports/a-vision-for-a-shared-data-infrastructure/industrial-data-production/ permanent
		redir /reports/a-vision-for-a-shared-data-infrastructure/a-vision-for-shared-data-infrastructure/building-a-california-health-data-infrastructure* /about/reports/a-vision-for-a-shared-data-infrastructure/building-a-california-health-data-infrastructure/ permanent
		redir /reports/* /about/reports/{path.1}/ permanent
		redir /contest /2015/01/sdsu-datathon/ permanent
		redir /contest/about /2015/01/sdsu-datathon/ permanent
		redir /contest/app https://civicknowledge.knackhq.com/datacontest permanent
		redir /contest/register https://civicknowledge.knackhq.com/datacontest#home/knack-register/all_users permanent
		redir /contest/awards http://www.eventbrite.com/e/sdsu-data-contest-awards-ceremony-tickets-15859650642?ref=ebtn permanent
		redir /proposals/student-data-analysis-contest* /2015/01/student-data-analysis-contest/ permanent
		redir /projects/student-data-analysis-contest* /2014/08/student-data-analysis-contest-2/ permanent
		redir /projects/sd-datathon* /2015/01/sdsu-datathon/ permanent
		redir /projects/sdsu-datathon* /2015/01/sdsu-datathon/ permanent
		redir /projects/food-network-data-library* /2016/05/healthy-food-access-data-library-project-2/ permanent
		redir /projects* /get-data/projects/ permanent
		redir /summer2018 /2018/04/summer-2018-projects-and-internships/ permanent
		redir /intern2018 /2018/04/summer-project-management-intern/ permanent
		redir /grant /get-data/data-grant/ permanent
		redir /pydata /2019/12/pydatala-presentation/ permanent
		redir /covid19 /2020/03/pro-bono-data-wrangling-for-biotechs/ permanent
		redir /c19data /get-data/projects/data-driven-coronavirus-recovery/ permanent
		redir /crime /2020/11/getting-started-with-crime-analysis/ permanent
		redir /slack https://join.slack.com/t/sandiegodata/shared_invite/zt-5ve41of5-Qy14UDIJsqgTfBhd8~AUMQ permanent
		# Q&A forum questions were not exported; send them to the service page
		redir /question/* /get-data/insights/ permanent
	}
}

# Order matters: route keeps these in the order written.
# args[0]: the www site's base URL, without a trailing slash
(data_sandiegodata) {
	route {
		redir / {args[0]}/dataset/ permanent
		redir /about* {args[0]}/dataset/about/ permanent
		redir /posts* {args[0]}/dataset/ permanent
		redir /datasets* {args[0]}/dataset/ permanent
		redir /homelessness* {args[0]}/collections/homelessness/ permanent
		redir /california-department-of-education* {args[0]}/collections/california-department-of-education/ permanent
		@upload path_regexp upload ^/wp-content/uploads/sites/(.*)$
		redir @upload {args[0]}/uploads/{re.upload.1} permanent
		redir * {args[0]}{uri} permanent
	}
}
