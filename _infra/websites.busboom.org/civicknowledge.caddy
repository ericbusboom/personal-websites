# Redirects for www.civicknowledge.com, to be imported by its site blocks in
# Caddyfile (`import civicknowledge_redirects`, before `import hugo ...`).
#
# Short links from the WordPress Redirection plugin (blog 3,
# _export/blog3_redirects.csv). All of them leave the site. Hugo serves the
# old WordPress page and post URLs as they were.

(civicknowledge_redirects) {
	route {
		redir /health-dataset-sources https://docs.google.com/spreadsheets/d/18Sglyd0ulnZuryMra5V0mN_jUavAwhTL9fCPga79FFw/edit?usp=sharing permanent
		redir /ext/cal_public_data https://docs.google.com/document/d/1P2zHQ3JrilUe9NfkzCv6ZIADfVMUb2RXsq1afk1czxQ/edit?usp=sharing permanent
		redir /cal_public_data https://docs.google.com/document/d/1P2zHQ3JrilUe9NfkzCv6ZIADfVMUb2RXsq1afk1czxQ/edit?usp=sharing permanent
		redir /data_package https://docs.google.com/document/d/1_lWnmON9NfPCHE9UsT0PwvRoI6LqdXAwzMOCD-iw05c/edit?usp=sharing permanent
		redir /upload https://script.google.com/a/macros/civicknowledge.com/s/AKfycbxrCppjkcKNLti5G9e0J5J3_mfyHEuashS7V-sBwR-J-0SmhBBz/exec permanent
		redir /eds https://docs.google.com/document/d/10aB2EJ8TeeYy3E5dGmpm6I-UF4B7ttCVn22hRzzg1gw/edit permanent
	}
}
