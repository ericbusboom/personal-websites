# websites.busboom.org — front door for every site in this repo.
#
# The public proxy (proxy.do.cnshost.net) terminates TLS and forwards plain
# HTTP here with the original Host header. Each site answers to:
#   http://<name>.{$TEST_HOST}       test URL, linked from the index page
#   http(s)://<its real domain>      production name; https here uses a
#                                    self-signed cert so you can test by
#                                    pointing /etc/hosts at this droplet
# Bare domains redirect to www, as on the public proxy.
{
	admin off
	servers {
		# Keep X-Forwarded-Proto: https from the public proxy so WordPress
		# knows the visitor is on https.
		trusted_proxies static {$PROXY_IP:137.184.225.100}/32 private_ranges
	}
}

(hugo) {
	root * /srv/sites/{args[0]}/{args[1]}
	encode zstd gzip
	file_server
	handle_errors 404 {
		root * /srv/sites/{args[0]}/{args[1]}
		rewrite * /404.html
		file_server
	}
}

(prod) {
	tls internal
	import hugo {args[0]} prod
}

# Index page listing every site.
http://{$TEST_HOST} {
	root * /srv/index
	file_server
}

# --- Test URLs --------------------------------------------------------------

http://eric.{$TEST_HOST} {
	import hugo eric test
}

http://max.{$TEST_HOST} {
	import hugo max test
}

http://metatab.{$TEST_HOST} {
	import hugo metatab test
}

http://civicknowledge.{$TEST_HOST} {
	import hugo civicknowledge test
}

http://sandiegodata.{$TEST_HOST} {
	import hugo sandiegodata test
}

http://explainers.{$TEST_HOST} {
	import hugo explainers test
}

http://troop506.{$TEST_HOST} {
	reverse_proxy troop506:80
}

# Hugo rebuild of www.lajollatroop506.com (static.lajollatroop506.com in the index).
http://static.{$TEST_HOST} {
	import hugo static test
}

# --- Production names -------------------------------------------------------

http://eric.busboom.org, https://eric.busboom.org {
	import prod eric
}

