	import prod civicknowledge
}

http://www.sandiegodata.org, https://www.sandiegodata.org {
	import prod sandiegodata
}

http://www.lajollatroop506.com, https://www.lajollatroop506.com {
	tls internal
	reverse_proxy troop506:80
}

http://metatab.org, https://metatab.org,
http://civicknowledge.com, https://civicknowledge.com,
http://sandiegodata.org, https://sandiegodata.org,
http://lajollatroop506.com, https://lajollatroop506.com {
	tls internal
	redir https://www.{host}{uri} permanent
}
